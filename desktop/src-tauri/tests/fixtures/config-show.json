{
  "general": {
    "output_dir": "/home/user/books/audiobooks",
    "resume": true,
    "log_level": "INFO",
    "progress": "auto",
    "heartbeat_seconds": 0.0
  },
  "pdf": {
    "ocr": "auto",
    "ocr_language": "eng",
    "password_env": null,
    "ocr_dpi": 300,
    "remove_page_numbers": true,
    "remove_headers": true,
    "remove_footers": true,
    "footnotes": "warn"
  },
  "chapters": {
    "min_boundary_confidence": 0.75,
    "allow_single_chapter": false
  },
  "llm": {
    "enabled": true,
    "provider": "ollama",
    "temperature": 0.1,
    "max_context_tokens": 16384,
    "max_output_tokens": 1024,
    "chunk_tokens": 4000,
    "max_retries": 3,
    "max_requests": null,
    "max_reported_tokens": null,
    "max_estimated_cost_usd": null,
    "input_cost_usd_per_million_tokens": null,
    "output_cost_usd_per_million_tokens": null,
    "structure": true,
    "contents": false,
    "cleanup": true,
    "classification": true,
    "narration": true,
    "vision": false,
    "allow_remote_content": false,
    "fallback_to_deterministic": false,
    "openai": {
      "model": "gpt-4.1-mini",
      "base_url": null,
      "api_key_env": "OPENAI_API_KEY",
      "timeout_seconds": 60.0
    },
    "ollama": {
      "model": "qwen3.5:9b",
      "base_url": "http://127.0.0.1:11434/v1",
      "api_key_env": null,
      "timeout_seconds": 300.0
    },
    "llama_server": {
      "model": "auto",
      "base_url": "http://127.0.0.1:8080/v1",
      "api_key_env": "LLAMA_SERVER_API_KEY",
      "timeout_seconds": 60.0
    }
  },
  "tts": {
    "provider": "kitten",
    "output_format": "mp3",
    "bitrate": "128k",
    "sample_rate": 24000,
    "pause_ms": 250,
    "max_retries": 2,
    "kitten": {
      "model": "mini",
      "voice": "Jasper",
      "speed": 1.0
    },
    "piper": {
      "model_path": "",
      "voice": "",
      "speed": 1.0
    },
    "profiles": {},
    "pronunciations": {}
  },
  "cache": {
    "enabled": true,
    "directory": "~/.cache/pdf2audiobook"
  },
  "audio": {
    "cover_image": null
  },
  "reading": {
    "process_citations": true,
    "process_equations": true
  },
