{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inspect MANIFEST --json",
  "description": "A workspace's chapters, coverage and (after conversion) per-chapter audio status.",
  "type": "object",
  "required": [
    "approved",
    "chapters",
    "coverage",
    "review_acknowledged",
    "review_required",
    "source_path",
    "title",
    "warnings"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "confidence",
          "end_block",
          "id",
          "manually_approved",
          "number",
          "start_block",
          "title",
          "voice_id",
          "warnings"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "start_block": {
            "type": "integer",
            "minimum": 0
          },
          "end_block": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "manually_approved": {
            "type": "boolean"
          },
          "voice_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "chapters",
        "empty_chapters",
        "valid"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "chapters": {
          "type": "integer",
          "minimum": 0
        },
        "empty_chapters": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conversion_status": {
      "type": "object",
      "required": [
        "chapters",
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "type": "integer"
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "status"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "source_path": {
      "type": "string"
    },
    "review_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_acknowledged": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
