{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "convert --dry-run --json",
  "description": "The planned MP3s, without synthesis.",
  "type": "object",
  "required": [
    "chapters",
    "dry_run",
    "mp3_files",
    "skipped_chapters",
    "warnings",
    "would_acknowledge"
  ],
  "properties": {
    "dry_run": {
      "const": true
    },
    "chapters": {
      "type": "integer",
      "minimum": 0
    },
    "mp3_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped_chapters": {
      "type": "array"
    },
    "would_acknowledge": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voice_clone": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Voice cloning diagnostics",
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "reference_configured": {
          "type": "boolean"
        },
        "transcript_configured": {
          "type": "boolean"
        },
        "model_ready": {
          "type": "boolean"
        },
        "transcription_ready": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        }
      },
      "required": [
        "supported",
        "enabled",
        "reference_configured",
        "transcript_configured"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
