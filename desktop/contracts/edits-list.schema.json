{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "edits list --json",
  "description": "Edit IDs and statuses; book text never appears in JSON.",
  "type": "object",
  "required": [
    "edits",
    "warnings"
  ],
  "properties": {
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "chapter",
          "provider",
          "status"
        ],
        "properties": {
          "block_id": {
            "type": "string"
          },
          "chapter": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "provider": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
