{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doctor --json",
  "description": "Setup check shown on the Setup screen.",
  "type": "object",
  "required": [
    "ffmpeg",
    "kitten_installed",
    "llm_provider",
    "llm_timeout_seconds",
    "ocr_installed_languages",
    "ocr_missing_languages",
    "ocr_requested_languages",
    "piper_installed",
    "process_citations",
    "process_equations",
    "tesseract",
    "version",
    "warnings"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "ffmpeg": {
      "type": "boolean"
    },
    "tesseract": {
      "type": "boolean"
    },
    "ocr_requested_languages": {
      "type": "string"
    },
    "ocr_installed_languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ocr_missing_languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kitten_installed": {
      "type": "boolean"
    },
    "piper_installed": {
      "type": "boolean"
    },
    "llm_provider": {
      "enum": [
        "ollama",
        "openai",
        "llama-server",
        "disabled"
      ]
    },
    "process_citations": {
      "type": "boolean"
    },
    "process_equations": {
      "type": "boolean"
    },
    "llm_timeout_seconds": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "llm_check": {
      "description": "Present with --check-llm. Only Ollama is checked; others report checked=false.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "provider",
            "checked"
          ],
          "properties": {
            "provider": {
              "enum": [
                "openai",
                "llama-server",
                "disabled"
              ]
            },
            "checked": {
              "const": false
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "provider",
            "checked",
            "model",
            "configured_context",
            "output_tokens",
            "chunk_tokens",
            "estimated_tokens_needed",
            "reachable",
            "served_context",
            "enough"
          ],
          "properties": {
            "provider": {
              "const": "ollama"
            },
            "checked": {
              "const": true
            },
            "model": {
              "type": "string"
            },
            "configured_context": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "chunk_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_tokens_needed": {
              "type": "integer",
              "minimum": 0
            },
            "reachable": {
              "type": "boolean"
            },
            "served_context": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "enough": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
